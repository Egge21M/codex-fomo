{
  "schemaVersion": 1,
  "id": "egge.codex-usage",
  "name": "Codex FOMO",
  "version": "0.2.0",
  "author": "egge",
  "description": "Estimated unused weekly Codex allowance since recording began, with current usage and reset timing.",
  "kinds": ["bar-widget"],
  "entryPoints": { "barWidget": "Panel.qml" },
  "barWidget": {
    "displayName": "Codex FOMO",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": { "refreshIntervalSec": 60 },
    "schema": [{
      "key": "refreshIntervalSec", "type": "integer", "label": "Refresh local summary (seconds)",
      "min": 10, "max": 300, "step": 10, "defaultValue": 60
    }]
  }
}
