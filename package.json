{
  "name": "codex-fomo",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "poll": "bun run index.ts poll",
    "status": "bun run index.ts status",
    "history": "bun run index.ts history",
    "summary": "bun run index.ts summary",
    "tokens": "bun run index.ts tokens",
    "install:plugin": "bun run scripts/install-plugin.ts",
    "install:timer": "bun run scripts/install-timer.ts",
    "test": "bun test",
    "typecheck": "bun check",
    "release:pack": "bun run scripts/release.ts",
    "verify": "bun check && bun test",
    "build:exporter": "bun build index.ts --target=bun --outfile=dist/exporter/index.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.3"
  },
  "description": "Track weekly Codex allowance, inferred resets, and estimated unused API value locally.",
